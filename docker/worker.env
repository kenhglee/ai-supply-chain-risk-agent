# Runtime configuration for running the risk worker in a plain container.
# Mirrors the Lambda environment in terraform/lambda.tf. No credentials or
# secrets here: pass short-lived AWS credentials with -e at docker run time.
AWS_DEFAULT_REGION=us-west-2
LOG_LEVEL=INFO
LLM_PROVIDER=bedrock
BEDROCK_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0
EMBEDDING_PROVIDER=bedrock
RISK_STATE_BACKEND=dynamodb
RISK_STATE_TABLE=supplier_risk_state
TRACE_STORE_BACKEND=dynamodb
RISK_TRACES_TABLE=risk_traces
CHECKPOINT_TABLE=risk_agent_checkpoints
RUNTIME_DIR=/tmp
OUTPUT_MODE=lambda
